# OpenAI API Key (used for Whisper STT and OpenAI TTS)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (used for fast LLM inference)
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model (e.g., llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# TTS Voice for Edge-TTS Neural Voices:
# Indian English Female: en-IN-NeerjaNeural (Default) | Indian English Male: en-IN-PrabhatNeural
# Hindi Female: hi-IN-SwaraNeural | Hindi Male: hi-IN-MadhurNeural
TTS_VOICE=en-IN-NeerjaNeural

# Wake word trigger phrase model (e.g., max, alexa, hey_jarvis, grey)
WAKE_MODEL=max

# Wake word detection sensitivity threshold (0.0 to 1.0, default 0.40; higher reduces false positives)
WAKE_THRESHOLD=0.40

# Max hands-free speech recording limit in seconds (default 5.0)
MAX_RECORD_SECONDS=5.0

# Optional Audio Device Overrides (Leave empty to use OS defaults or auto-select)
# Use 'python audio_io.py --list' to view device indices on your Pi
MIC_DEVICE_INDEX=
SPEAKER_DEVICE_INDEX=

# Voice Barge-In Interrupt (Default false to prevent speaker echo from cutting off speech)
ENABLE_VOICE_BARGE_IN=false
BARGE_IN_RMS_THRESHOLD=2500
